{
  "name": "playwright-visual-regression-testing-framework",
  "version": "1.0.0",
  "description": "A professional TypeScript Playwright visual regression testing framework with deterministic local demo pages.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:visual": "playwright test tests/visual",
    "test:visual:chromium": "playwright test --project=chromium-visual tests/visual",
    "test:visual:mobile": "playwright test --project=chromium-mobile tests/visual",
    "test:smoke": "playwright test tests/smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "snapshots:update": "playwright test tests/visual --update-snapshots",
    "snapshots:update:chromium": "playwright test --project=chromium-visual tests/visual --update-snapshots",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "node scripts/clean-artifacts.mjs",
    "ci": "npm run format:check && npm run typecheck && npm run lint && npm run test:smoke && npm run test:visual",
    "docker:test": "docker compose run --rm visual-tests npm run ci",
    "docker:update-snapshots": "docker compose run --rm visual-tests npm run snapshots:update"
  },
  "engines": {
    "node": ">=20.11 <25"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "22.13.14",
    "dotenv": "16.4.7",
    "eslint": "9.22.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-playwright": "2.2.0",
    "http-server": "14.1.1",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.1"
  }
}
